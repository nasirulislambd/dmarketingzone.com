---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import Highlight from '../components/Highlight.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Placeholder from '../components/Placeholder.astro';
import { site, stats, strategyCallLink } from '../content/site';
import {
  hero,
  whoWeServe,
  services,
  whyUs,
  featuredWork,
  ramadanBanner,
  howWeWork,
  testimonials,
  finalCta,
} from '../content/home';
---

<BaseLayout
  title="DMarketing Zone | Halal E-commerce Social Media & Marketing Agency"
  description="Social media strategy, product content, Ramadan & Eid campaigns and monthly reports for halal food, modest fashion, organic, supplement and ethical e-commerce brands."
>
  <!-- HERO -->
  <section class="relative overflow-hidden bg-neutral-light" aria-labelledby="hero-title">
    <div
      class="pointer-events-none absolute -top-32 -right-32 h-96 w-96 rounded-full bg-brand-green-tint"
      aria-hidden="true"
    >
    </div>
    <div class="container-site relative grid items-center gap-12 py-16 sm:py-20 lg:grid-cols-12 lg:py-28">
      <div class="lg:col-span-7">
        <p class="eyebrow">{hero.eyebrow}</p>
        <h1
          id="hero-title"
          class="mt-4 text-4xl leading-[1.1] font-extrabold tracking-tight sm:text-5xl lg:text-[3.5rem]"
        >
          <Highlight text={hero.title} />
        </h1>
        <p class="mt-6 max-w-xl text-lg text-neutral-muted sm:text-xl">{hero.subtitle}</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <Button href={strategyCallLink} size="lg" arrow>{hero.primaryCta}</Button>
          <Button href="/work" variant="outline" size="lg">{hero.secondaryCta}</Button>
        </div>
      </div>

      <div class="lg:col-span-5">
        <div class="rounded-3xl border border-neutral-line bg-white p-6 shadow-xl shadow-brand-green/5 sm:p-8">
          <p class="text-lg font-bold text-brand-green">{hero.card.title}</p>
          <ul class="mt-5 space-y-4">
            {
              hero.card.items.map((item) => (
                <li class="flex items-start gap-3">
                  <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-lime text-brand-green-dark">
                    <Icon name="check" size={16} strokeWidth={3} />
                  </span>
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
          <div class="mt-6 border-t border-neutral-line pt-5 text-sm text-neutral-muted">
            For halal food, modest fashion, organic, supplement and ethical brands.
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TRUST BAR -->
  <section aria-label="Our track record" class="border-y border-neutral-line bg-white">
    <div class="container-site py-8">
      <ul class="grid grid-cols-2 gap-6 text-center sm:grid-cols-3 lg:grid-cols-5">
        {
          stats.map((s, i) => (
            <li class:list={[i === stats.length - 1 && 'col-span-2 sm:col-span-1']}>
              <p class="text-3xl font-extrabold text-brand-green">{s.value}</p>
              <p class="mt-1 text-sm text-neutral-muted">{s.label}</p>
            </li>
          ))
        }
      </ul>
      <p class="mt-6 text-center text-sm text-neutral-muted">
        {
          site.fiverrUrl ? (
            <a href={site.fiverrUrl} class="font-semibold text-brand-green underline underline-offset-4" rel="noopener" target="_blank">
              Read our reviews on Fiverr<span class="sr-only"> (opens in a new tab)</span>
            </a>
          ) : (
            <>
              Our reviews on Fiverr <Placeholder note="Fiverr agency profile URL" />
            </>
          )
        }
      </p>
    </div>
  </section>

  <!-- WHO WE SERVE -->
  <section class="section" aria-labelledby="serve-title">
    <div class="container-site">
      <SectionHeading id="serve-title" eyebrow={whoWeServe.eyebrow} title={whoWeServe.title} intro={whoWeServe.intro} />
      <ul class="mt-12 flex flex-wrap justify-center gap-5">
        {
          whoWeServe.niches.map((n) => (
            <li class="w-full rounded-2xl border border-neutral-line bg-white p-6 transition-shadow hover:shadow-lg sm:w-[calc(50%-0.625rem)] lg:w-[calc(33.333%-0.84rem)]">
              <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-green-tint text-brand-green">
                <Icon name={n.icon} size={24} />
              </span>
              <h3 class="mt-4 text-lg font-bold">{n.title}</h3>
              <p class="mt-2 text-neutral-muted">{n.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="section bg-neutral-light" aria-labelledby="services-title">
    <div class="container-site">
      <SectionHeading id="services-title" eyebrow={services.eyebrow} title={services.title} intro={services.intro} />
      <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          services.items.map((s) => (
            <li>
              <a
                href={`/services#${s.slug}`}
                class="group flex h-full flex-col rounded-2xl border border-neutral-line bg-white p-6 transition-all hover:-translate-y-0.5 hover:border-brand-green hover:shadow-lg"
              >
                <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-green text-brand-lime">
                  <Icon name={s.icon} size={24} />
                </span>
                <h3 class="mt-4 text-lg leading-snug font-bold">{s.title}</h3>
                <p class="mt-2 flex-1 text-neutral-muted">{s.text}</p>
                <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-green">
                  Learn more
                  <span class="transition-transform group-hover:translate-x-1">
                    <Icon name="arrow-right" size={16} />
                  </span>
                </span>
              </a>
            </li>
          ))
        }
        <li class="flex flex-col rounded-2xl border-2 border-dashed border-neutral-line p-6">
          <p class="inline-flex w-fit rounded-full bg-brand-green-tint px-3 py-1 text-xs font-semibold tracking-wide text-brand-green uppercase">
            Coming soon
          </p>
          <h3 class="mt-4 text-lg font-bold">More services we plan to add</h3>
          <ul class="mt-3 space-y-2 text-neutral-muted">
            {services.comingSoon.map((c) => <li>{c}</li>)}
          </ul>
        </li>
      </ul>
      <div class="mt-10 text-center">
        <Button href="/services" variant="outline" arrow>See all services</Button>
      </div>
    </div>
  </section>

  <!-- WHY US -->
  <section class="section" aria-labelledby="why-title">
    <div class="container-site grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <div class="lg:sticky lg:top-28">
          <SectionHeading id="why-title" eyebrow={whyUs.eyebrow} title={whyUs.title} intro={whyUs.intro} align="left" />
          <div class="mt-8">
            <Button href={strategyCallLink} arrow>Book a Free Strategy Call</Button>
          </div>
        </div>
      </div>
      <ol class="space-y-4 lg:col-span-7">
        {
          whyUs.items.map((w, i) => (
            <li class="flex gap-5 rounded-2xl border border-neutral-line bg-white p-6">
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-brand-green-tint text-brand-green">
                <Icon name={w.icon} size={24} />
              </span>
              <div>
                <h3 class="text-lg font-bold">
                  <span class="sr-only">{i + 1}. </span>
                  {w.title}
                </h3>
                <p class="mt-1 text-neutral-muted">{w.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- FEATURED WORK -->
  <section class="section bg-neutral-light" aria-labelledby="work-title">
    <div class="container-site">
      <SectionHeading id="work-title" eyebrow={featuredWork.eyebrow} title={featuredWork.title} intro={featuredWork.intro} />

      <h3 class="mt-12 text-xl font-bold">Client work</h3>
      <ul class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          featuredWork.clients.map((c) => (
            <li class="overflow-hidden rounded-2xl border border-neutral-line bg-white">
              {c.image ? (
                <Image
                  src={c.image}
                  alt={c.imageAlt}
                  widths={[320, 480, 640]}
                  sizes="(min-width: 1024px) 280px, (min-width: 640px) 50vw, 100vw"
                  class="aspect-[4/5] w-full object-cover"
                />
              ) : (
                <div class="flex aspect-[4/3] flex-col items-center justify-center gap-3 bg-brand-green-tint p-4 text-center sm:aspect-[4/5]">
                  <span class="text-2xl font-extrabold text-brand-green">{c.name}</span>
                  <Placeholder note={`${c.name} work visuals + client permission`} />
                </div>
              )}
              <div class="p-6">
                <p class="text-xs font-semibold tracking-wide text-brand-green uppercase">Client work</p>
                <h4 class="mt-2 text-lg font-bold text-brand-green">{c.name}</h4>
                <p class="mt-1 text-sm text-neutral-muted">{c.category}</p>
                <p class="mt-3">{c.work}</p>
              </div>
            </li>
          ))
        }
      </ul>

      <h3 class="mt-14 text-xl font-bold">Concept projects</h3>
      <p class="mt-2 max-w-2xl text-neutral-muted">
        Demo brands we created to show our approach in specific halal niches. They are not real clients.
      </p>
      <ul class="mt-5 grid gap-5 lg:grid-cols-2">
        {
          featuredWork.concepts.map((c) => (
            <li class="grid overflow-hidden rounded-2xl border border-neutral-line bg-white md:grid-cols-2">
              <div class="relative">
                {c.image ? (
                  <Image
                    src={c.image}
                    alt={c.imageAlt}
                    widths={[320, 480, 640]}
                    sizes="(min-width: 1024px) 280px, (min-width: 768px) 50vw, 100vw"
                    class="aspect-[4/5] h-full w-full object-cover"
                  />
                ) : (
                  <div class="flex aspect-[4/5] h-full flex-col items-center justify-center gap-3 bg-neutral-light p-4 text-center">
                    <span class="text-2xl font-extrabold text-brand-green">{c.name}</span>
                    <Placeholder note={`${c.name} concept visuals`} />
                  </div>
                )}
                <span class="absolute bottom-3 left-3 rounded-full bg-brand-green-dark px-3 py-1 text-xs font-bold tracking-wide text-white uppercase">
                  Concept project
                </span>
              </div>
              <div class="p-6">
                <h4 class="text-lg font-bold text-brand-green">{c.name}</h4>
                <p class="mt-1 text-sm text-neutral-muted">{c.category}</p>
                <p class="mt-3">{c.work}</p>
                <p class="mt-4 rounded-lg border border-neutral-line bg-neutral-light px-3 py-2 text-sm text-neutral-muted">
                  {c.label}
                </p>
              </div>
            </li>
          ))
        }
      </ul>

      <div class="mt-10 text-center">
        <Button href="/work" variant="outline" arrow>See all our work</Button>
      </div>
    </div>
  </section>

  <!-- RAMADAN & EID 2027 BANNER -->
  <section class="section" aria-labelledby="ramadan-title">
    <div class="container-site">
      <div class="on-dark relative overflow-hidden rounded-3xl bg-brand-green-dark px-6 py-12 sm:px-12 sm:py-16">
        <div class="pointer-events-none absolute -right-10 -bottom-16 text-brand-lime/15" aria-hidden="true">
          <Icon name="moon" size={280} strokeWidth={1.25} />
        </div>
        <div class="relative max-w-2xl">
          <p class="eyebrow text-brand-lime">{ramadanBanner.eyebrow}</p>
          <h2 id="ramadan-title" class="mt-3 text-3xl leading-tight font-extrabold tracking-tight text-white sm:text-4xl">
            <Highlight text={ramadanBanner.title} onDark />
          </h2>
          <p class="mt-4 text-lg text-white/85">{ramadanBanner.text}</p>
          <div class="mt-8">
            <Button href="/ramadan-eid-2027" size="lg" arrow>{ramadanBanner.cta}</Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW WE WORK -->
  <section class="section bg-neutral-light" aria-labelledby="process-title">
    <div class="container-site">
      <SectionHeading id="process-title" eyebrow={howWeWork.eyebrow} title={howWeWork.title} />
      <div class="mt-4 text-center"><Placeholder note={howWeWork.placeholder} /></div>
      <ol class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          howWeWork.steps.map((step, i) => (
            <li class="rounded-2xl border border-neutral-line bg-white p-6">
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-brand-green text-lg font-extrabold text-white" aria-hidden="true">
                {i + 1}
              </span>
              <h3 class="mt-4 text-lg font-bold">
                <span class="sr-only">Step {i + 1}: </span>
                {step.title}
              </h3>
              <p class="mt-2 text-neutral-muted">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- TESTIMONIALS (real Fiverr reviews, edit in src/content/home.ts; hidden if the list is empty) -->
  {
    testimonials.length > 0 && (
      <section class="section" aria-labelledby="testimonials-title">
        <div class="container-site">
          <SectionHeading
            id="testimonials-title"
            eyebrow="Client reviews"
            title="What our *clients* say"
            intro="Word-for-word reviews from clients we have worked with on Fiverr."
          />
          <ul class="mt-12 columns-1 gap-5 md:columns-2 lg:columns-3">
            {testimonials.map((t) => (
              <li class="mb-5 break-inside-avoid rounded-2xl border border-neutral-line bg-white p-6">
                <figure>
                  <p class="flex gap-0.5 text-brand-green" role="img" aria-label="5 out of 5 stars">
                    {[1, 2, 3, 4, 5].map(() => (
                      <Icon name="star" size={18} class="fill-current" />
                    ))}
                  </p>
                  <blockquote class="mt-4">
                    <p class="text-neutral-dark">“{t.quote}”</p>
                  </blockquote>
                  <figcaption class="mt-5 border-t border-neutral-line pt-4 text-sm">
                    <span class="block font-bold text-brand-green">{t.name}</span>
                    <span class="text-neutral-muted">{[t.location, t.source].filter(Boolean).join(' · ')}</span>
                  </figcaption>
                </figure>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- FINAL CTA -->
  <section class="section pb-28 sm:pb-32" aria-labelledby="cta-title">
    <div class="container-site">
      <div class="rounded-3xl bg-brand-green-tint px-6 py-12 text-center sm:px-12 sm:py-16">
        <h2 id="cta-title" class="mx-auto max-w-2xl text-3xl leading-tight font-extrabold tracking-tight sm:text-4xl">
          <Highlight text={finalCta.title} />
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-lg text-neutral-muted">{finalCta.text}</p>
        <div class="mt-8">
          <Button href={strategyCallLink} size="lg" arrow>{finalCta.cta}</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
