---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Placeholder from '../components/Placeholder.astro';
import { site } from '../content/site';
const a = site.address;
---

<BaseLayout title="Privacy Policy" description="How DMarketing Zone collects, uses and protects your information when you use dmarketingzone.com.">
  <PageHero eyebrow="Legal" title="Privacy *Policy*" intro="Last updated: [PLACEHOLDER: date]" />
  <section class="section pt-12">
    <div class="container-site max-w-3xl">
      <Placeholder note="general template only. Please have it reviewed by a legal professional before publishing" block />
      <div class="prose-site">
        <h2>Who we are</h2>
        <p>
          This website is run by {site.name}, a social media and marketing agency located at {a.street}, {a.locality}, {a.region},
          {a.country}. If you have questions about this policy, email us at <a href={`mailto:${site.email}`}>{site.email}</a>.
        </p>

        <h2>Information we collect</h2>
        <p>We only collect information you choose to give us, for example when you:</p>
        <ul>
          <li>fill in our contact form (your name, email, brand name, website or social link, niche, the service you are interested in, budget range and message);</li>
          <li>message us on WhatsApp or by email.</li>
        </ul>
        <p>Like most websites, our hosting provider may also record basic technical information such as your browser type and IP address for security.</p>

        <h2>How we use your information</h2>
        <ul>
          <li>to reply to your enquiry and talk with you about our services;</li>
          <li>to prepare a quote or proposal you ask for;</li>
          <li>to keep the website secure and working well.</li>
        </ul>
        <p>We do not sell your personal information.</p>

        <h2>Services we use</h2>
        <p>
          Our contact form is processed by a third-party form service (Web3Forms), which sends your message to our email. Our website is hosted by Cloudflare (Cloudflare Pages). <Placeholder note="analytics tool, if one is added" />
        </p>

        <h2>Cookies</h2>
        <p>
          <Placeholder note="update this section if analytics or advertising cookies are added" /> At the moment this website does not use cookies for advertising.
        </p>

        <h2>How long we keep your information</h2>
        <p>We keep enquiry messages only as long as we need them to respond and for our normal business records. <Placeholder note="confirm retention period" /></p>

        <h2>Your rights</h2>
        <p>You can ask us to see, correct or delete the personal information we hold about you. Email <a href={`mailto:${site.email}`}>{site.email}</a> and we will help.</p>

        <h2>Changes to this policy</h2>
        <p>We may update this policy from time to time. The latest version will always be on this page.</p>
      </div>
    </div>
  </section>
</BaseLayout>
