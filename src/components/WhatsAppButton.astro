---
/*
  Floating WhatsApp button.
  It appears on the live site only after the WhatsApp number is set in
  src/content/site.ts. While you preview locally (npm run dev) it is shown
  as a placeholder so you can see where it sits.
*/
import { whatsappLink } from '../content/site';
import Icon from './Icon.astro';
const show = whatsappLink || import.meta.env.DEV;
---

{
  show && (
    <a
      href={whatsappLink ?? '#'}
      target={whatsappLink ? '_blank' : undefined}
      rel={whatsappLink ? 'noopener' : undefined}
      class="fixed right-4 bottom-4 z-30 inline-flex items-center gap-2 rounded-full bg-brand-green py-3 pr-5 pl-4 font-semibold text-white shadow-lg ring-2 ring-white transition-colors hover:bg-brand-green-dark sm:right-6 sm:bottom-6"
      title={whatsappLink ? undefined : '[PLACEHOLDER: WhatsApp number]. Hidden on the live site until set.'}
    >
      <Icon name="message-circle" size={22} />
      <span class="hidden sm:inline">Chat on WhatsApp</span>
      <span class="sr-only sm:hidden">Chat on WhatsApp</span>
      {whatsappLink && <span class="sr-only"> (opens in a new tab)</span>}
    </a>
  )
}
