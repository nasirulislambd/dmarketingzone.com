---
/*
  Highlight: turns 'Built for *halal* brands' into a headline
  where the word between *stars* is shown in lime green.
  On white backgrounds a deeper lime is used so it stays readable.
*/
interface Props {
  text: string;
  onDark?: boolean;
}
const { text, onDark = false } = Astro.props;
const parts = text.split(/\*(.+?)\*/g);
const hlClass = onDark ? 'text-brand-lime' : 'text-brand-lime-deep';
---

{parts.map((part, i) => (i % 2 === 1 ? <span class={hlClass}>{part}</span> : part))}
