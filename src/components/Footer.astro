---
import { site, nav, liveSocials, whatsappLink } from '../content/site';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import Placeholder from './Placeholder.astro';

const year = new Date().getFullYear();
const quickLinks = [
  ...nav,
  { label: 'Ramadan & Eid 2027', href: '/ramadan-eid-2027' },
  { label: 'Privacy Policy', href: '/privacy' },
];
const a = site.address;
---

<footer class="on-dark relative mt-8 bg-brand-green-dark text-white">
  <!-- Curved top edge (signature brand element) -->
  <svg
    class="absolute inset-x-0 top-px block h-12 w-full -translate-y-full text-brand-green-dark sm:h-16 lg:h-20"
    viewBox="0 0 1440 120"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <path fill="currentColor" d="M0 120V60C240 10 480 0 720 0s480 10 720 60v60H0Z"></path>
  </svg>

  <div class="container-site grid gap-10 pt-10 pb-12 sm:grid-cols-2 lg:grid-cols-12 lg:gap-8 lg:pt-8">
    <div class="lg:col-span-5">
      <a href="/" aria-label="DMarketing Zone, home" class="inline-block"><Logo onDark /></a>
      <p class="mt-4 max-w-sm text-white/85">{site.shortTagline}</p>
      <p class="mt-2 max-w-sm text-sm text-white/70">Based in Rangpur, Bangladesh. Serving clients worldwide.</p>

      <div class="mt-6">
        <h2 class="text-sm font-semibold tracking-wide text-brand-lime uppercase">Follow us</h2>
        {
          liveSocials.length ? (
            <ul class="mt-3 flex flex-wrap gap-2">
              {liveSocials.map((s) => (
                <li>
                  <a
                    href={s.url}
                    rel="noopener"
                    target="_blank"
                    class="inline-block rounded-full border border-white/25 px-3 py-1.5 text-sm text-white/90 hover:border-brand-lime hover:text-brand-lime"
                  >
                    {s.name}
                    <span class="sr-only"> (opens in a new tab)</span>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="mt-3 text-sm text-white/85">
              {site.handle} <Placeholder note="confirm which social accounts are live" />
            </p>
          )
        }
      </div>
    </div>

    <div class="lg:col-span-3">
      <h2 class="text-sm font-semibold tracking-wide text-brand-lime uppercase">Quick links</h2>
      <ul class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2 sm:grid-cols-1">
        {
          quickLinks.map((l) => (
            <li>
              <a href={l.href} class="text-white/85 hover:text-brand-lime">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="sm:col-span-2 lg:col-span-4">
      <h2 class="text-sm font-semibold tracking-wide text-brand-lime uppercase">Contact</h2>
      <ul class="mt-3 space-y-4">
        <li class="flex items-start gap-3">
          <span class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white/10 text-brand-lime">
            <Icon name="mail" size={18} />
          </span>
          <span class="pt-1.5">
            {
              site.email ? (
                <a href={`mailto:${site.email}`} class="text-white/90 hover:text-brand-lime">
                  {site.email}
                </a>
              ) : (
                <Placeholder note="agency email" />
              )
            }
          </span>
        </li>
        <li class="flex items-start gap-3">
          <span class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white/10 text-brand-lime">
            <Icon name="message-circle" size={18} />
          </span>
          <span class="pt-1.5">
            {
              whatsappLink ? (
                <a href={whatsappLink} class="text-white/90 hover:text-brand-lime" rel="noopener" target="_blank">
                  Chat on WhatsApp<span class="sr-only"> (opens in a new tab)</span>
                </a>
              ) : (
                <Placeholder note="WhatsApp number" />
              )
            }
          </span>
        </li>
        <li class="flex items-start gap-3">
          <span class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white/10 text-brand-lime">
            <Icon name="map-pin" size={18} />
          </span>
          <address class="pt-1.5 text-white/90 not-italic">
            {a.street}, {a.locality},<br />
            {a.region}, {a.country}
          </address>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/15">
    <div class="container-site flex flex-col gap-2 py-6 text-sm text-white/70 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {site.name}. All rights reserved.</p>
      <p>Halal & ethical e-commerce marketing</p>
    </div>
  </div>
</footer>
