---
import { site, nav, liveSocials, whatsappLink } from '../content/site';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import BrandIcon from './BrandIcon.astro';

const year = new Date().getFullYear();
const quickLinks = [
  ...nav,
  { label: 'Ramadan & Eid 2027', href: '/ramadan-eid-2027' },
  { label: 'Privacy Policy', href: '/privacy' },
];
const a = site.address;
---

<footer class="on-dark relative mt-10 bg-brand-green-dark text-white">
  <!-- Curved top edge (signature brand element) -->
  <svg
    class="absolute inset-x-0 top-px block h-12 w-full -translate-y-full text-brand-green-dark sm:h-16 lg:h-24"
    viewBox="0 0 1440 120"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <path fill="currentColor" d="M0 120V60C240 10 480 0 720 0s480 10 720 60v60H0Z"></path>
  </svg>

  <div class="container-site grid gap-12 pt-10 pb-14 lg:grid-cols-12 lg:gap-8 lg:pt-6">
    <div class="lg:col-span-5">
      <a href="/" aria-label="DMarketing Zone, home" class="inline-block"><Logo onDark /></a>
      <p class="mt-6 max-w-sm font-display text-2xl leading-snug font-semibold text-white">
        Social media & marketing for <span class="text-brand-lime">halal</span> and ethical e‑commerce brands.
      </p>
      <p class="mt-3 max-w-sm text-white/70">Based in Rangpur, Bangladesh. Serving clients worldwide.</p>

      {
        liveSocials.length > 0 && (
          <ul class="mt-8 flex flex-wrap gap-3" aria-label="Social media">
            {liveSocials.map((s) => (
              <li>
                <a
                  href={s.url}
                  rel="noopener"
                  target="_blank"
                  class="flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-brand-lime hover:text-brand-green-dark"
                >
                  <BrandIcon name={s.icon} size={18} />
                  <span class="sr-only">{s.name} (opens in a new tab)</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <div class="grid gap-10 sm:grid-cols-2 lg:col-span-7 lg:grid-cols-5">
      <div class="lg:col-span-2">
        <h2 class="font-sans text-sm font-bold tracking-wider text-brand-lime uppercase">Explore</h2>
        <ul class="mt-4 space-y-2.5">
          {
            quickLinks.map((l) => (
              <li>
                <a href={l.href} class="text-white/85 transition-colors hover:text-brand-lime">
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="lg:col-span-3">
        <h2 class="font-sans text-sm font-bold tracking-wider text-brand-lime uppercase">Talk to us</h2>
        <ul class="mt-4 space-y-4">
          {
            whatsappLink && (
              <li>
                <a href={whatsappLink} rel="noopener" target="_blank" class="group flex items-center gap-3">
                  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-lime text-brand-green-dark">
                    <BrandIcon name="whatsapp" size={18} />
                  </span>
                  <span>
                    <span class="block text-sm text-white/60">WhatsApp</span>
                    <span class="text-white group-hover:text-brand-lime">{site.whatsappDisplay}</span>
                    <span class="sr-only"> (opens in a new tab)</span>
                  </span>
                </a>
              </li>
            )
          }
          {
            site.email && (
              <li>
                <a href={`mailto:${site.email}`} class="group flex items-center gap-3">
                  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white/10 text-brand-lime">
                    <Icon name="mail" size={18} />
                  </span>
                  <span>
                    <span class="block text-sm text-white/60">Email</span>
                    <span class="text-white group-hover:text-brand-lime">{site.email}</span>
                  </span>
                </a>
              </li>
            )
          }
          <li class="flex items-center gap-3">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white/10 text-brand-lime">
              <Icon name="map-pin" size={18} />
            </span>
            <address class="text-white/90 not-italic">
              {a.street}, {a.locality},<br />
              {a.region}, {a.country}
            </address>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <div class="border-t border-white/15">
    <div class="container-site flex flex-col gap-2 py-6 text-sm text-white/65 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {site.name}. All rights reserved.</p>
      <p>Halal & ethical e‑commerce marketing</p>
    </div>
  </div>
</footer>
