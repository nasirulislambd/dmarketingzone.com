---
import { nav, strategyCallLink } from '../content/site';
import Logo from './Logo.astro';
import Button from './Button.astro';
import Icon from './Icon.astro';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) =>
  href === '/' ? current === '/' : current === href || current.startsWith(href + '/');
---

<header class="sticky top-0 z-40 border-b border-neutral-line bg-white/95 backdrop-blur">
  <a
    href="#main"
    class="sr-only rounded-md bg-brand-green px-4 py-2 font-semibold text-white focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50"
  >
    Skip to content
  </a>
  <div class="container-site flex h-16 items-center justify-between gap-4 lg:h-20">
    <a href="/" class="shrink-0" aria-label="DMarketing Zone, home">
      <Logo />
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                class:list={[
                  'rounded-full px-4 py-2 text-[0.95rem] font-medium transition-colors',
                  isCurrent(item.href)
                    ? 'bg-brand-green-tint text-brand-green'
                    : 'text-neutral-dark hover:bg-neutral-light hover:text-brand-green',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <span class="hidden sm:block"><Button href={strategyCallLink}>Book a Free Strategy Call</Button></span>
      <button
        type="button"
        class="inline-flex h-11 w-11 items-center justify-center rounded-full text-brand-green hover:bg-neutral-light lg:hidden"
        aria-controls="mobile-menu"
        aria-expanded="false"
        data-menu-toggle
      >
        <span class="sr-only" data-menu-label>Open menu</span>
        <span data-icon-open><Icon name="menu" size={26} /></span>
        <span data-icon-close class="hidden"><Icon name="x" size={26} /></span>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" aria-label="Mobile" class="hidden border-t border-neutral-line bg-white lg:hidden" data-menu>
    <ul class="container-site flex flex-col py-3">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
              class:list={[
                'block rounded-lg px-3 py-3 text-base font-medium',
                isCurrent(item.href) ? 'bg-brand-green-tint text-brand-green' : 'text-neutral-dark hover:bg-neutral-light',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
      <li class="mt-3 mb-2 sm:hidden">
        <Button href={strategyCallLink} size="lg" class="w-full">Book a Free Strategy Call</Button>
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.classList.toggle('hidden', !open);
      toggle.querySelector('[data-icon-open]')?.classList.toggle('hidden', open);
      toggle.querySelector('[data-icon-close]')?.classList.toggle('hidden', !open);
      const label = toggle.querySelector('[data-menu-label]');
      if (label) label.textContent = open ? 'Close menu' : 'Open menu';
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
    window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => e.matches && setOpen(false));
  }
</script>
