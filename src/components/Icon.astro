---
/*
  Icon: shows a Lucide icon by name, e.g. <Icon name="leaf" />.
  To use a new icon, import it below and add it to the map.
  Browse icons at https://lucide.dev
*/
import {
  ArrowRight, BadgeCheck, BookOpen, CalendarDays, ChartColumn, Check, Clapperboard,
  Leaf, Mail, MapPin, Megaphone, Menu, MessageCircle, Moon, Route, Shirt, Sparkles,
  Sprout, Star, Target, TrendingUp, Utensils, WandSparkles, X,
} from '@lucide/astro';

const icons = {
  'arrow-right': ArrowRight, 'badge-check': BadgeCheck, 'book-open': BookOpen,
  'calendar-days': CalendarDays, 'chart-column': ChartColumn, check: Check,
  clapperboard: Clapperboard, leaf: Leaf, mail: Mail, 'map-pin': MapPin, megaphone: Megaphone,
  menu: Menu, 'message-circle': MessageCircle, moon: Moon, route: Route, shirt: Shirt,
  sparkles: Sparkles, sprout: Sprout, star: Star, target: Target, 'trending-up': TrendingUp,
  utensils: Utensils, 'wand-sparkles': WandSparkles, x: X,
} as const;

export type IconName = keyof typeof icons;

interface Props {
  name: IconName | string;
  size?: number;
  class?: string;
  strokeWidth?: number;
}
const { name, size = 24, class: className, strokeWidth = 2 } = Astro.props;
const Component = icons[name as IconName];
if (!Component) throw new Error(`Icon "${name}" is not in src/components/Icon.astro`);
---

<Component size={size} class={className} stroke-width={strokeWidth} aria-hidden="true" focusable="false" />
